# Copy this file to .env and fill in a real token. Never commit .env.
#
# Generate a strong token, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HOMELAB_MCP_TOKEN=changeme

# Bind address and port. Defaults shown below.
HOMELAB_MCP_HOST=0.0.0.0
HOMELAB_MCP_PORT=8811

#Optional additional denied files and folders for read files and directory listings
#HOMELAB_MCP_DENIED_FILES="/testpath/file-a",/anypath/myfile
#HOMELAB_MCP_DENIED_FOLDERS="/blahblah/path",/another/path

# Optional: allow run_vm_console_command to type a command into a VM's local
# serial console (`virsh console <vm>`), logging the command and its output.
# libvirt domain names the agent may choose from (comma-separated) and the log
# file that receives each executed command and its output (appended). The
# service user needs access to libvirt (e.g. group "libvirt"); set
# LIBVIRT_DEFAULT_URI=qemu:///system if the VMs run under the system instance.
# The VM console must offer a ready shell (e.g. auto-login on ttyS0).
#HOMELAB_MCP_KVM_VMS=vm1,vm2
#HOMELAB_MCP_KVM_LOG=/var/log/homelab-mcp/kvm.log
#LIBVIRT_DEFAULT_URI=qemu:///system
