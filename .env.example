# Copy this file to .env and fill in a real token. Never commit .env.
#
# Generate a strong token, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HOMELAB_MCP_TOKEN=changeme

# Bind address and port. Defaults shown below.
HOMELAB_MCP_HOST=0.0.0.0
HOMELAB_MCP_PORT=8811

#Optional additional denied files and folders for read files and directory listings
#HOMELAB_MCP_DENIED_FILES="/testpath/file-a",/anypath/myfile
#HOMELAB_MCP_DENIED_FOLDERS="/blahblah/path",/another/path

# Optional: allow run_ssh_command to execute `ssh <vm> '<command>'` and log it.
# VM names the agent may choose from (comma-separated) and the log file that
# receives each executed command and its stdout (appended). The service user
# needs passwordless (key-based) SSH access to these hosts.
#HOMELAB_MCP_SSH_VMS=kvm-vm1,kvm-vm2
#HOMELAB_MCP_SSH_LOG=/var/log/homelab-mcp/ssh.log
