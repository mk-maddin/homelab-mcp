[Unit]
Description=homelab-mcp - read-only MCP server for home server health
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=homelab-mcp
Group=homelab-mcp
WorkingDirectory=/opt/homelab-mcp
EnvironmentFile=/opt/homelab-mcp/.env
ExecStart=/opt/homelab-mcp/.venv/bin/homelab-mcp
Restart=on-failure
RestartSec=5

# Hardening. Group membership (systemd-journal for journal access,
# docker for the Docker socket, if present) is granted by deploy/install.sh
# via `usermod -aG` -- no SupplementaryGroups= needed here.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/homelab-mcp

[Install]
WantedBy=multi-user.target
